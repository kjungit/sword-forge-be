# Local backend runtime environment.
# Copy to .env, then use scripts/local_server_start.sh.

# h2: no Docker required, persistent DB under .local/
# postgres: starts docker compose postgres/redis when Docker is available.
SWORD_FORGE_DB=h2

POSTGRES_DB=sword_forge
POSTGRES_USER=sword_forge
POSTGRES_PASSWORD=sword_forge
POSTGRES_PORT=5432
REDIS_PORT=6379

SERVER_PORT=8080
APP_SECURITY_ENABLED=true
SPRING_SECURITY_USER_NAME=local_user
SPRING_SECURITY_USER_PASSWORD=local_password

APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
